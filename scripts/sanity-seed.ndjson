e":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00001j","text":"Classic web agency:","marks":["strong"]},{"_type":"span","_key":"k00001k","text":" €3,000–15,000 for comparable projects — more overhead.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00001l","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00001m","text":"Larger agency / complex projects:","marks":["strong"]},{"_type":"span","_key":"k00001n","text":" from €20,000 — e-commerce, multilingual platforms, custom tools.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00001o","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00001p","text":"What typically drives the price","marks":[]}]},{"_type":"block","_key":"k00001q","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00001r","text":"Scope:","marks":["strong"]},{"_type":"span","_key":"k00001s","text":" one page costs less than ten — obvious, but often underestimated.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00001t","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00001u","text":"Copy and images:","marks":["strong"]},{"_type":"span","_key":"k00001v","text":" if you don’t provide them, you pay for production.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00001w","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00001x","text":"Features:","marks":["strong"]},{"_type":"span","_key":"k00001y","text":" online booking, shop, member area — that’s real software, not an “add-on”.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00001z","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000020","text":"Design complexity:","marks":["strong"]},{"_type":"span","_key":"k000021","text":" standard layouts are cheaper; strong custom branding costs more.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k000022","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k000023","text":"Don’t forget running costs","marks":[]}]},{"_type":"block","_key":"k000024","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000025","text":"A site isn’t “done” after launch. Rough figures:","marks":[]}]},{"_type":"block","_key":"k000026","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000027","text":"Hosting: €5–20 / month (Germany)","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k000028","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000029","text":"Domain: €10–20 / year","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00002a","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00002b","text":"Maintenance & updates: varies by stack","marks":[]}],"listItem":"bullet","level":1}],"ru":[{"_type":"block","_key":"k00002c","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00002d","text":"Вопрос, который часто всплывает — и редко имеет простой ответ. Здесь собраны ориентиры из открытых источников и обсуждений. ","marks":[]},{"_type":"span","_key":"k00002e","text":"Это не предложение","marks":["strong"]},{"_type":"span","_key":"k00002f","text":", а заметка для чтения.","marks":[]}]},{"_type":"block","_key":"k00002g","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00002h","text":"Ориентиры, которые часто называют","marks":[]}]},{"_type":"block","_key":"k00002i","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00002j","text":"Конструкторы (Wix, Jimdo, Squarespace):","marks":["strong"]},{"_type":"span","_key":"k00002k","text":" примерно 10–30 € в месяц — сборка своими руками, ограниченный дизайн.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00002l","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00002m","text":"Фрилансер / один разработчик:","marks":["strong"]},{"_type":"span","_key":"k00002n","text":" часто 600–3 000 € разово за небольшой бизнес-сайт.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00002o","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00002p","text":"Классическое агентство:","marks":["strong"]},{"_type":"span","_key":"k00002q","text":" 3 000–15 000 € за сопоставимые проекты — больше накладных расходов.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00002r","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00002s","text":"Крупное агентство / сложные проекты:","marks":["strong"]},{"_type":"span","_key":"k00002t","text":" от 20 000 € — интернет-магазины, мультиязычность, кастомные инструменты.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00002u","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00002v","text":"От чего обычно зависит цена","marks":[]}]},{"_type":"block","_key":"k00002w","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00002x","text":"Объём:","marks":["strong"]},{"_type":"span","_key":"k00002y","text":" одна страница дешевле десяти — логично, но часто недооценивают.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00002z","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000030","text":"Тексты и картинки:","marks":["strong"]},{"_type":"span","_key":"k000031","text":" если не свои — платите за создание.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k000032","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000033","text":"Функции:","marks":["strong"]},{"_type":"span","_key":"k000034","text":" онлайн-запись, магазин, личный кабинет — это отдельная разработка, не «дополнение».","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k000035","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000036","text":"Сложность дизайна:","marks":["strong"]},{"_type":"span","_key":"k000037","text":" шаблон дешевле; сильный индивидуальный брендинг дороже.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k000038","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k000039","text":"Не забывайте о расходах после запуска","marks":[]}]},{"_type":"block","_key":"k00003a","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003b","text":"Сайт после публикации не «готов навсегда». Грубо:","marks":[]}]},{"_type":"block","_key":"k00003c","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003d","text":"Хостинг: 5–20 € / месяц (Германия)","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00003e","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003f","text":"Домен: 10–20 € / год","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00003g","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003h","text":"Поддержка и обновления: зависит от стека","marks":[]}],"listItem":"bullet","level":1}]}}
{"_id":"blogPost-baukasten","_type":"blogPost","slug":{"_type":"slug","current":"baukasten"},"order":20,"readMin":5,"meta":{"de":"Strategie","en":"Strategy","ru":"Стратегия"},"title":{"de":"Baukasten vs. eigener Code","en":"Site builder vs. custom code","ru":"Конструктор vs собственный код"},"body":{"de":[{"_type":"block","_key":"k00003i","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003j","text":"Wix, Jimdo, Squarespace – „Website in 10 Minuten“. Klingt verlockend, ist aber nicht für jeden Fall die richtige Wahl. Diese Notiz sammelt Punkte, die man vor der Entscheidung im Hinterkopf haben sollte.","marks":[]}]},{"_type":"block","_key":"k00003k","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00003l","text":"1. Miete vs. Eigentum","marks":[]}]},{"_type":"block","_key":"k00003m","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003n","text":"Ein Baukasten ist ein Abo. Endet das Abo, ist die Seite weg. Eine eigene Lösung läuft auf eigenem Hosting – die Migration und Datenhoheit liegen bei einem selbst.","marks":[]}]},{"_type":"block","_key":"k00003o","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00003p","text":"2. Geschwindigkeit und SEO","marks":[]}]},{"_type":"block","_key":"k00003q","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003r","text":"Baukasten-Seiten enthalten oft viel automatisch erzeugtes Markup. Eine schlanke, individuell strukturierte Seite hat es bei Page-Speed-Themen meist leichter.","marks":[]}]},{"_type":"block","_key":"k00003s","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00003t","text":"3. Datenschutz","marks":[]}]},{"_type":"block","_key":"k00003u","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003v","text":"Manche Baukästen laden externe Schriften, Tracker oder Skripte. Wer den Datenschutz selbst kontrollieren will, hat mit eigenem Code weniger Überraschungen – setzt aber natürlich auch eigenes Wissen voraus.","marks":[]}]},{"_type":"block","_key":"k00003w","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00003x","text":"4. Migration und Lock-in","marks":[]}]},{"_type":"block","_key":"k00003y","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00003z","text":"Beim Wechsel von einem Baukasten lassen sich Inhalte oft nicht 1:1 exportieren. Das ist kein Showstopper, aber ein Punkt, den man kennen sollte.","marks":[]}]},{"_type":"block","_key":"k000040","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k000041","text":"Wann ein Baukasten ein guter Weg ist","marks":[]}]},{"_type":"block","_key":"k000042","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000043","text":"Schnelles Ausprobieren einer Idee in 1–2 Wochen.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k000044","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000045","text":"Reine Visitenkarte für ein temporäres Projekt.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k000046","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000047","text":"Internes Projekt ohne hohe Performance- oder SEO-Anforderungen.","marks":[]}],"listItem":"bullet","level":1}],"en":[{"_type":"block","_key":"k000048","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000049","text":"Wix, Jimdo, Squarespace — “website in 10 minutes”. Tempting, but not the right fit for every case. Notes to keep in mind before you decide.","marks":[]}]},{"_type":"block","_key":"k00004a","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00004b","text":"1. Rent vs. ownership","marks":[]}]},{"_type":"block","_key":"k00004c","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004d","text":"A builder is a subscription. When it ends, the site can disappear. Your own solution runs on your hosting — you control migration and data.","marks":[]}]},{"_type":"block","_key":"k00004e","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00004f","text":"2. Speed and SEO","marks":[]}]},{"_type":"block","_key":"k00004g","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004h","text":"Builder pages often ship lots of auto-generated markup. A lean, hand-structured site usually wins on page speed.","marks":[]}]},{"_type":"block","_key":"k00004i","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00004j","text":"3. Privacy","marks":[]}]},{"_type":"block","_key":"k00004k","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004l","text":"Some builders load external fonts, trackers or scripts. With your own code you control privacy better — but you need the know-how.","marks":[]}]},{"_type":"block","_key":"k00004m","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00004n","text":"4. Migration and lock-in","marks":[]}]},{"_type":"block","_key":"k00004o","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004p","text":"Leaving a builder often means content doesn’t export 1:1. Not a deal-breaker, but worth knowing.","marks":[]}]},{"_type":"block","_key":"k00004q","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00004r","text":"When a builder is a good fit","marks":[]}]},{"_type":"block","_key":"k00004s","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004t","text":"Quickly testing an idea in 1–2 weeks.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00004u","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004v","text":"A simple business card site for a temporary project.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00004w","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004x","text":"Internal projects without strict performance or SEO needs.","marks":[]}],"listItem":"bullet","level":1}],"ru":[{"_type":"block","_key":"k00004y","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00004z","text":"Wix, Jimdo, Squarespace — «сайт за 10 минут». Звучит заманчиво, но подходит не всем. Заметка о том, что учесть до выбора.","marks":[]}]},{"_type":"block","_key":"k000050","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k000051","text":"1. Аренда vs владение","marks":[]}]},{"_type":"block","_key":"k000052","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000053","text":"Конструктор — это подписка. Закончилась — сайт может пропасть. Свой код на своём хостинге — вы сами про миграцию и данные.","marks":[]}]},{"_type":"block","_key":"k000054","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k000055","text":"2. Скорость и SEO","marks":[]}]},{"_type":"block","_key":"k000056","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k000057","text":"У конструкторов часто много автоматической разметки. Лёгкий ручной сайт обычно быстрее.","marks":[]}]},{"_type":"block","_key":"k000058","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k000059","text":"3. Защита данных","marks":[]}]},{"_type":"block","_key":"k00005a","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00005b","text":"Часть конструкторов тянет внешние шрифты, трекеры и скрипты. Со своим кодом проще контролировать приватность — но нужны знания.","marks":[]}]},{"_type":"block","_key":"k00005c","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00005d","text":"4. Миграция и привязка","marks":[]}]},{"_type":"block","_key":"k00005e","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00005f","text":"При уходе с конструктора контент редко переносится один в один. Не катастрофа, но важный нюанс.","marks":[]}]},{"_type":"block","_key":"k00005g","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"k00005h","text":"Когда конструктор уместен","marks":[]}]},{"_type":"block","_key":"k00005i","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00005j","text":"Быстро проверить идею за 1–2 недели.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00005k","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00005l","text":"Визитка на время для временного проекта.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"k00005m","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"k00005n","text":"Внутренний проект без жёстких требований к скорости и SEO.","marks":[]}],"listItem":"bullet","level":1}]}}
