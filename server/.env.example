# ============================================
# SendGrid configuration (sole email transport)
# ============================================

# Get API key: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Sender address — MUST belong to a domain verified in SendGrid
# (Settings → Sender Authentication → Domain Authentication).
# Recommended: an address on your own domain, e.g. kontakt@your-domain.tld
EMAIL_FROM=kontakt@your-domain.tld

# Recipient — incoming form messages will be delivered here
EMAIL_TO=you@your-domain.tld

# Frontend origin allowed by CORS (your live site URL)
FRONTEND_URL=https://your-domain.tld

# Local dev port — Render sets its own PORT in production
PORT=3001
