// Cloudflare Workers: сайт отдаётся как статические файлы из dist/,
// серверного кода нет. Без этого файла шаг деплоя `npx wrangler deploy`
// падает: ему не на что указывать — ни скрипта воркера, ни папки с файлами.
//
// Cloudflare Pages этот файл игнорирует (в нём нет pages_build_output_dir),
// там папка dist/ указывается в настройках проекта.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ay-webstudio",
    "compatibility_date": "2025-09-01",
    // Обработчик формы: всё, кроме /api/contact, отдаёт ASSETS.
    "main": "src/index.js",

    // Отправка писем без стороннего сервиса. Включается так:
    //   1. в панели Cloudflare: Email → Email Routing → включить для домена;
    //   2. там же подтвердить адрес получателя (Destination address);
    //   3. раскомментировать блок ниже и подставить свой адрес;
    //   4. задать переменные EMAIL_FROM (адрес на своём домене, например
    //      formular@ay-webstudio.de) и EMAIL_TO (подтверждённый получатель).
    // Пока блок закомментирован, письма уходят через SendGrid — если заданы
    // секреты SENDGRID_API_KEY, EMAIL_FROM и EMAIL_TO.
    // "send_email": [
    //     { "name": "SEND_EMAIL", "destination_address": "info.ay.webstudio.de@gmail.com" }
    // ],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // Несуществующий адрес → наш 404.html вместо пустой ошибки Cloudflare.
        "not_found_handling": "404-page"
    }
}
