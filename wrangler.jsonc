// Cloudflare Workers: сайт отдаётся как статические файлы из dist/,
// серверного кода нет. Без этого файла шаг деплоя `npx wrangler deploy`
// падает: ему не на что указывать — ни скрипта воркера, ни папки с файлами.
//
// Cloudflare Pages этот файл игнорирует (в нём нет pages_build_output_dir),
// там папка dist/ указывается в настройках проекта.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ay-webstudio",
    "compatibility_date": "2025-09-01",
    // Обработчик формы: всё, кроме /api/contact, отдаёт ASSETS.
    "main": "src/index.js",

    // Адреса — не секреты, поэтому лежат прямо здесь. Секретом остаётся
    // только SENDGRID_API_KEY, и то лишь если письма шлются через SendGrid.
    "vars": {
        "EMAIL_FROM": "formular@ay-webstudio.de",
        "EMAIL_TO": "info.ay.webstudio.de@gmail.com"
    },

    // Отправка писем без стороннего сервиса. Осталось два шага в панели
    // Cloudflare, их нельзя сделать из кода:
    //   1. Email → Email Routing → Enable для ay-webstudio.de;
    //   2. Destination addresses → добавить EMAIL_TO и подтвердить его
    //      по ссылке из письма.
    // После этого снять // с трёх строк ниже и задеплоить. Раскомментировать
    // раньше нельзя: деплой упадёт с «destination address not verified».
    // Альтернатива без Email Routing — секрет SENDGRID_API_KEY.
    // "send_email": [
    //     { "name": "SEND_EMAIL", "destination_address": "info.ay.webstudio.de@gmail.com" }
    // ],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // Несуществующий адрес → наш 404.html вместо пустой ошибки Cloudflare.
        "not_found_handling": "404-page"
    }
}
